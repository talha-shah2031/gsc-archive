{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GSC Studio",
  "version": "0.1.0",
  "identifier": "com.muham.gscstudio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GSC Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/talha-shah2031/gsc-archive/releases/latest"
      ],
      "pubkey": ""
    }
  }
}
